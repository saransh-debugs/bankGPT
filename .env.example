# Copy to .env and fill in. .env is gitignored; secrets never enter the repo
# and never enter a capability artifact.

# --- Discovery only -----------------------------------------------------------
# Required ONLY for `npm run discover` (the LLM-driven discovery run).
# Replay never reads this: src/replay/guard.ts fails the run if anything on the
# replay path so much as resolves the Anthropic client.
ANTHROPIC_API_KEY=sk-ant-...

# --- Target surface -----------------------------------------------------------
FINERACT_BASE_URL=https://localhost:8443
FINERACT_TENANT=default
WEB_APP_URL=http://localhost:4200

# Credentials for the seeded demo instance. These are the stock Fineract
# defaults on a fresh install, not real credentials.
#
# Steps marked `redact: true` in an artifact resolve their value from THESE
# variables at replay time. The artifact stores the variable name, never the
# secret.
FINERACT_USER=mifos
FINERACT_PASSWORD=password

# A second login provisioned by `npm run seed` with a role that deliberately
# lacks READ_SAVINGSACCOUNT, used to produce a genuine 403 from the product's
# own RBAC rather than a simulated one.
FINERACT_LIMITED_USER=teller_readonly
FINERACT_LIMITED_PASSWORD=Northridge#2026
